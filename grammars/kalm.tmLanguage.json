{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kalm",
  "scopeName": "source.kalm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#interpolated-string"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#contextual-call"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#class-names"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.kalm",
          "match": "###.*$"
        },
        {
          "name": "comment.block.kalm",
          "begin": "##",
          "end": "##"
        },
        {
          "include": "#line-comment"
        }
      ]
    },
    "line-comment": {
      "name": "comment.line.number-sign.kalm",
      "match": "#.*$"
    },
    "interpolated-string": {
      "name": "string.quoted.double.kalm",
      "begin": "@\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kalm"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kalm"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.kalm",
          "match": "\\$\\$"
        },
        {
          "name": "constant.character.escape.kalm",
          "match": "\\\\[nrt\\\\\"]"
        },
        {
          "name": "variable.other.interpolated.kalm",
          "match": "\\$[\\p{L}_][\\p{L}\\p{Nd}_]*"
        },
        {
          "name": "meta.interpolation.kalm",
          "begin": "\\$\\{",
          "end": "}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.kalm"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.kalm"
            }
          },
          "patterns": [
            {
              "include": "$self"
            },
            {
              "name": "variable.other.kalm",
              "match": "\\b[\\p{L}_][\\p{L}\\p{Nd}_]*\\b"
            }
          ]
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.kalm",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kalm"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kalm"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.kalm",
          "match": "\\\\[nrt\\\\\"]"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.kalm",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?[fFL]?\\b"
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(pub)\\s+(fun)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.kalm"
            },
            "2": {
              "name": "storage.type.function.kalm"
            },
            "3": {
              "name": "entity.name.function.kalm"
            }
          }
        },
        {
          "match": "\\b(fun)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.kalm"
            },
            "2": {
              "name": "entity.name.function.kalm"
            }
          }
        },
        {
          "match": "\\b(pub)\\s+(class)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.kalm"
            },
            "2": {
              "name": "storage.type.class.kalm"
            },
            "3": {
              "name": "entity.name.type.class.kalm"
            }
          }
        },
        {
          "match": "\\b(class|contract|data|choice|singleton|annotation|alias)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.kalm"
            },
            "2": {
              "name": "entity.name.type.class.kalm"
            }
          }
        },
        {
          "match": "\\b(class)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.kalm"
            },
            "2": {
              "name": "entity.name.type.class.kalm"
            }
          }
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.kalm",
      "match": "\\b(?:space|use|pub|internal|private|protected|class|contract|fun|var|fix|implements|inherits|base|needs|closed|extendable|singleton|data|choice|alias|given|generate|augment|read|write|lazy|late|constant|forward|match|case|yield|if|elif|else|while|for|in|next|stop|return|self|super|with|defer|async|await|task|guard|try|handle|finally|raise|expect|require|ensure|external|bridge|annotation|target|legacy|test|before|after|init|override|as|is|and|or|not)\\b"
    },
    "builtin-types": {
      "name": "support.type.kalm",
      "match": "\\b(?:void|boolean|byte|short|int|long|float|double|char|Unit|Any|Bool|Byte|Short|Int|Long|Float|Double|Char|Text|Array|BoolArray|ByteArray|ShortArray|IntArray|LongArray|FloatArray|DoubleArray|CharArray|List|Map|Task)\\b"
    },
    "class-names": {
      "name": "support.type.kalm",
      "match": "\\b[\\p{Lu}][\\p{L}\\p{Nd}_]*\\b"
    },
    "constants": {
      "name": "constant.language.kalm",
      "match": "\\b(?:true|false|null)\\b"
    },
    "function-call": {
      "name": "entity.name.function.call.kalm",
      "match": "\\b[\\p{L}_][\\p{L}\\p{Nd}_]*(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.kalm",
      "match": "(?:as\\?|!!|\\?\\?=|\\?\\?|\\?\\.|\\?\\[|=>|->|==|!=|<=|>=|&&|\\|\\||[?:=+*/%<>.!-])"
    },
    "annotation": {
      "match": "(@)([\\p{L}_][\\p{L}\\p{Nd}_]*(?:\\.[\\p{L}_][\\p{L}\\p{Nd}_]*)*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.annotation.kalm"
        },
        "2": {
          "name": "storage.type.annotation.kalm"
        }
      }
    },
    "contextual-call": {
      "name": "entity.name.function.call.kalm",
      "match": "(?<=\\.)(?:not|await|test|match|and|or|fixed|implements|case)\\b|\\b(?:not|await|test|match|and|or|fixed|implements|case)(?=\\s*\\()"
    }
  }
}
